{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPlanner",
  "version": "0.1.0",
  "identifier": "ru.den1s1.myplanner",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyPlanner",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "sticker",
        "title": "MyPlanner — Стикер",
        "url": "index.html?mode=sticky",
        "width": 390,
        "height": 570,
        "minWidth": 340,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
