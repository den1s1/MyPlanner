<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6cb2b334-d1c5-4e15-bde3-3da3bc58f773</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>MyPlanner</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="MyPlanner" />
  <Description DefaultValue="Создание заметок и задач MyPlanner из писем Outlook." />
  <IconUrl DefaultValue="https://den1s1.github.io/MyPlanner/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://den1s1.github.io/MyPlanner/icon-128.png" />
  <SupportUrl DefaultValue="https://github.com/den1s1/MyPlanner" />
  <AppDomains>
    <AppDomain>https://den1s1.github.io</AppDomain>
  </AppDomains>
  <Hosts><Host Name="Mailbox" /></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.3" /></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="https://den1s1.github.io/MyPlanner/taskpane.html" /><RequestedHeight>250</RequestedHeight></DesktopSettings></Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" /></Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.3"><bt:Set Name="Mailbox" /></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <ExtensionPoint xsi:type="MessageReadCommandSurface"><OfficeTab id="TabDefault"><Group id="MyPlanner.Group">
        <Label resid="Group.Label" />
        <Control xsi:type="Button" id="MyPlanner.Capture"><Label resid="Capture.Label" /><Supertip><Title resid="Capture.Label" /><Description resid="Capture.Description" /></Supertip><Icon><bt:Image size="16" resid="Icon.16" /><bt:Image size="32" resid="Icon.32" /><bt:Image size="80" resid="Icon.80" /></Icon><Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url" /></Action></Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://den1s1.github.io/MyPlanner/icon-32.png" /><bt:Image id="Icon.32" DefaultValue="https://den1s1.github.io/MyPlanner/icon-32.png" /><bt:Image id="Icon.80" DefaultValue="https://den1s1.github.io/MyPlanner/icon-128.png" /></bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="https://den1s1.github.io/MyPlanner/taskpane.html" /></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="MyPlanner" /><bt:String id="Capture.Label" DefaultValue="В MyPlanner" /></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Capture.Description" DefaultValue="Создать заметку или задачу из открытого письма" /></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
